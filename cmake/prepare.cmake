# Copy a submodule into the build tree and apply our patches to the copy
# (CLAUDE.md: never edit third_party/ in place). Re-runs when a patch changes.
#   spyro_prepare(<name> <src dir> <patch dir> <out var>)
function(spyro_prepare name src patchdir outvar)
  set(dst "${CMAKE_BINARY_DIR}/patched/${name}")
  file(GLOB patches CONFIGURE_DEPENDS "${patchdir}/*.patch")
  list(SORT patches)
  set(stamp "${dst}.stamp")
  set(want "")
  foreach(p ${patches})
    file(SHA1 "${p}" h)
    string(APPEND want "${p} ${h}\n")
  endforeach()
  set(have "")
  if(EXISTS "${stamp}")
    file(READ "${stamp}" have)
  endif()
  if(NOT EXISTS "${dst}" OR NOT have STREQUAL want)
    file(REMOVE_RECURSE "${dst}")
    file(COPY "${src}/" DESTINATION "${dst}" PATTERN ".git" EXCLUDE PATTERN "build" EXCLUDE)
    foreach(p ${patches})
      execute_process(COMMAND patch -p1 --forward --quiet -i "${p}"
        WORKING_DIRECTORY "${dst}" RESULT_VARIABLE rc)
      if(NOT rc EQUAL 0)
        message(FATAL_ERROR "patch failed: ${p}")
      endif()
    endforeach()
    # file(COPY) keeps the submodule's mtimes, so a changed or dropped patch
    # could leave objects newer than their sources: touch the whole copy.
    file(GLOB_RECURSE copied "${dst}/*")
    file(TOUCH_NOCREATE ${copied})
    file(WRITE "${stamp}" "${want}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${patches})
  set(${outvar} "${dst}" PARENT_SCOPE)
endfunction()
