+/* Spyro port (docs/decisions.md D82): native draw lists.
+ * - g_psyxPacketHook: called by the OT walk for each packet with a nonzero
+ *   length, before its GP0 commands are parsed; nonzero means it has emitted
+ *   the packet itself (the walk then goes on as after any packet).
+ * - PsyX_AddSplit: what parsing a polygon does to the draw splits, for a
+ *   polygon with these flags under activeDrawEnv as it is now.
+ * - PsyX_VertexBuffer: the walk's vertex buffer and its fill (vertices).
+ * - PsyX_SplitCount/PsyX_SplitGet: the splits so far (index 1 up), for the
+ *   host's check; PsyX_ClearSplits empties both, as a drawn list does.
+ * - PsyX_ParseList: the OT walk of a list, without drawing it (the check). */
+extern int (*g_psyxPacketHook)(uintptr_t packet);
+extern void PsyX_AddSplit(int semiTrans, int textured);
+extern GrVertex* PsyX_VertexBuffer(int** fill);
+extern int PsyX_SplitCount(void);
+extern void PsyX_SplitGet(int i, int out[8]);
+extern void PsyX_ClearSplits(void);
+extern void PsyX_ParseList(u_long* p);
+
 extern void			GR_PushDebugLabel(const char* label);
 extern void			GR_PopDebugLabel();
 
