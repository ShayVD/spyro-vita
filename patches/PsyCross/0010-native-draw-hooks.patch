+	AddSplit(semiTrans != 0, textured != 0);
+}
+
+GrVertex* PsyX_VertexBuffer(int** fill)
+{
+	*fill = &g_vertexIndex;
+	return g_vertexBuffer;
+}
+
+int PsyX_SplitCount(void)
+{
+	return g_splitIndex;
+}
+
+void PsyX_SplitGet(int i, int out[8])
+{
+	const GPUDrawSplit& s = g_splits[i];
+	out[0] = s.blendMode;
+	out[1] = s.texFormat;
+	out[2] = (int)s.textureId;
+	out[3] = s.drawPrimMode;
+	out[4] = s.startVertex;
+	out[5] = s.numVerts;
+	out[6] = s.drawenv.dfe;
+	out[7] = s.drawenv.clip.x | s.drawenv.clip.y << 16;
+}
+
+void PsyX_ClearSplits(void)
+{
+	ClearSplits();
+}
