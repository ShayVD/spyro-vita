+#if !USE_EXTENDED_PRIM_POINTERS
+// Spyro port: words in the GP0 command starting at cmd (psx-spx "GPU Render
+// Polygon/Line/Rectangle Commands"), or 0 if it doesn't fit before end.
+static int Gp0CommandWords(const u_int* cmd, const u_int* end)
+{
+	const u_int c = cmd[0] >> 24;
+	switch (c >> 5)
+	{
+	case 1:	// polygon: colour, then per vertex xy (+uv), Gouraud adds colours
+	{
+		const int verts = (c & 8) ? 4 : 3;
+		return 1 + verts * ((c & 4) ? 2 : 1) + ((c & 0x10) ? verts - 1 : 0);
+	}
+	case 2:	// line, or polyline ended by a 0x5xxx5xxx word
+	{
+		if (!(c & 8))
+			return (c & 0x10) ? 4 : 3;
+		const int step = (c & 0x10) ? 2 : 1;
+		const u_int* w = cmd + 1 + 1;	// first vertex xy
+		while (w < end && (*w & 0xF000F000) != 0x50005000)
+			w += step;
+		return w < end ? int(w - cmd) + 1 : 0;
+	}
+	case 3:	// rectangle: colour, xy, (uv+clut), (wh if variable size)
+		return 2 + ((c & 4) ? 1 : 0) + (((c >> 3) & 3) == 0 ? 1 : 0);
+	case 4:	// VRAM to VRAM copy
+		return 4;
+	case 5:	// CPU to VRAM: command, xy, wh, then the pixels
+		return cmd + 2 < end ? 3 + int(((cmd[2] & 0xFFFF) * (cmd[2] >> 16) + 1) / 2) : 0;
+	case 6:	// VRAM to CPU
+		return 3;
+	case 7:	// environment (E1h-E6h)
+		return 1;
+	default:	// 00h NOP, 01h cache clear, 02h fill, 1Fh IRQ
+		return c == 0x02 ? 3 : 1;
+	}
+}
+#endif
