+// Spyro port (D92): see PsyX_render.h. The splits after the current one are
+// only written when a new one starts, so the current one is all to keep.
+struct PsyXSplitState
+{
+	int splitIndex, vertexIndex;
+	GPUDrawSplit cur;
+	const char* debugText;
+};
+
+int PsyX_SplitStateSize(void)
+{
+	return (int)sizeof(PsyXSplitState);
+}
+
+void PsyX_SplitStateSave(void* buf)
+{
+	PsyXSplitState* s = (PsyXSplitState*)buf;
+	s->splitIndex = g_splitIndex;
+	s->vertexIndex = g_vertexIndex;
+	s->cur = g_splits[g_splitIndex];
+	s->debugText = currentSplitDebugText;
+}
+
+void PsyX_SplitStateRestore(const void* buf)
+{
+	const PsyXSplitState* s = (const PsyXSplitState*)buf;
+	g_splitIndex = s->splitIndex;
+	g_vertexIndex = s->vertexIndex;
+	g_splits[g_splitIndex] = s->cur;
+	currentSplitDebugText = s->debugText;
+}
