+
+/* Spyro port (docs/decisions.md D38): called for each polygon's vertices
+ * (POLY_F/G/FT/GT, 3 or 4, before a quad is split into triangles) with the
+ * prim's own screen coordinates. It may fill each vertex's tcx/tcy/_p0/_p1
+ * (otherwise unused in this build) and nothing else. */
+extern void (*g_psyxPolyHook)(GrVertex* vertex, short* const* xy, int n);
 extern void			GR_DrawTriangles(int start_vertex, int triangles);
 
 extern void			GR_PushDebugLabel(const char* label);
diff --git a/include/psx/gtereg.h b/include/psx/gtereg.h
