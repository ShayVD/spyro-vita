@@ -108,6 +108,12 @@
 extern int GTE_operator(int);
 extern int LIM(int value, int max, int min, unsigned int flag);
 
+/* Spyro port (docs/decisions.md D38): called after RTPS/RTPT has projected
+ * vertex idx (0-2), with every register already written. It may only read
+ * gteRegs, so the results the game sees don't change. sf is the command's
+ * shift flag. */
+extern void (*g_psyxRtpHook)(int idx, int sf);
