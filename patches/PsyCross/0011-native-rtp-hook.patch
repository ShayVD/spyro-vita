+ * SZ3), with sf set. NULL unless the vertex cache records. */
+extern void (*g_psyxRtpValueHook)(const int *proj, int vx, int vy, int vz, unsigned int sxy, int sz3);
+
 #if defined(_LANGUAGE_C_PLUS_PLUS)||defined(__cplusplus)||defined(c_plusplus)
 }
 #endif
