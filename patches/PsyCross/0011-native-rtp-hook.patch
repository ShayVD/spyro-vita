@@ -114,6 +114,13 @@
  * shift flag. */
 extern void (*g_psyxRtpHook)(int idx, int sf);
 
+/* Spyro port (docs/decisions.md D89): the same for a projection made
+ * without the register file (the hand renderers' native GTE maths,
+ * fast_render=2, D80): proj holds R11-R33, TRX-TRZ, OFX, OFY and H as RTPS
