+#if REGION_HAS_PAL
+/**
+ * @brief PAL: create text Mobys, both of the US functions above in one, with
+ * the five languages' extra marks (PAL 0x8001BD5C, decisions D139).
+ *
+ * With pTextSpacing NULL every character is a capital, as func_80017FE4's.
+ * Otherwise the first letter of each word is a capital and the rest are
+ * moved by pTextSpacing, as func_800181AC's. A lowercase 'a'-'e' after a
+ * letter is its accent, Moby classes 365-369, laid over that letter; 'f' a
+ * raised period. Spanish turns '!' and '?' over when they open a sentence.
+ */
+Moby *func_pal_8001BD5C(u_char *pText, Vector3D *pPosition, Vector3D *pTextSpacing,
+                        int pSpaceWidth, int pShadeIndex) {
+  int isCapital;
+  int wasCapital;
+
+  isCapital = 1;
+  wasCapital = 1;
+  while (*pText != '\0') {
+    if (*pText != ' ') {
+      g_HudMobys -= 1;
+      Memset(g_HudMobys, 0, sizeof(Moby));
+      VecCopy(&g_HudMobys->m_Position, pPosition);
+      if (*pText >= 'A' && *pText <= 'Z') {
+        g_HudMobys->m_Class = MOBYCLASS_LETTER_A + *pText - 'A';
+      } else if (*pText >= '0' && *pText <= '9') {
+        isCapital = 1;
+        g_HudMobys->m_Class = MOBYCLASS_NUMBER_0 + *pText - '0';
+      } else if (*pText >= 'a' && *pText <= 'f') {
+        // An accent: back over the letter before
+        if (wasCapital) {
+          pPosition->x -= pSpaceWidth;
+        } else {
+          pPosition->x -= pTextSpacing->x;
+        }
+        g_HudMobys->m_Position.x = pPosition->x;
+        if (*pText >= 'a' && *pText <= 'e') {
+          g_HudMobys->m_Class = *pText + 268; // 365-369
+        }
+        if (*pText == 'f') {
+          g_HudMobys->m_Class = MOBYCLASS_PERIOD;
+          g_HudMobys->m_Position.y -= pSpaceWidth / 3;
+        }
+        isCapital = wasCapital;
+      } else if (*pText == '/') {
+        isCapital = 1;
+        g_HudMobys->m_Class = MOBYCLASS_SLASH;
+      } else if (*pText == '-') {
+        g_HudMobys->m_Class = MOBYCLASS_SLASH; // a dash: the slash turned
+        g_HudMobys->m_Rotation.x = 41;
+        g_HudMobys->m_Position.z += 2560;
+        isCapital = 1;
+      } else if (*pText == '%') {
+        isCapital = 1;
+        g_HudMobys->m_Class = MOBYCLASS_PERCENT;
+      } else if (*pText == '^') {
+        isCapital = 1;
+        g_HudMobys->m_Class = MOBYCLASS_CARET;
+      } else if (*pText == '+') {
+        isCapital = 1;
+        g_HudMobys->m_Class = MOBYCLASS_PLUS;
+      } else if (*pText == '!') {
+        g_HudMobys->m_Class = MOBYCLASS_EXCLAMATION_MARK;
+        if (g_Language == 3 && pText[1] != ' ' && pText[1] != '\0') {
+          g_HudMobys->m_Rotation.x = 128; // Spanish: opening, upside down
+        }
+        isCapital = 1;
+      } else if (*pText == '?') {
+        g_HudMobys->m_Class = MOBYCLASS_QUESTION_MARK;
+        if (g_Language == 3 && pText[1] != ' ' && pText[1] != '\0') {
+          g_HudMobys->m_Rotation.x = 128;
+        }
+        isCapital = 1;
+      } else if (*pText == '.') {
+        g_HudMobys->m_Class = MOBYCLASS_PERIOD;
+      } else if (*pText == ',') {
+        g_HudMobys->m_Class = MOBYCLASS_LETTER_APOSTROPHE;
+      } else {
+        g_HudMobys->m_Class = MOBYCLASS_LETTER_APOSTROPHE;
+        g_HudMobys->m_Position.y -= pSpaceWidth * 2 / 3;
+      }
+      g_HudMobys->m_DepthOffset = 0x7F;
+      g_HudMobys->m_SpecularMetalType = pShadeIndex;
+      g_HudMobys->m_RenderRadius = 0xFF;
+      if (isCapital) {
+        pPosition->x += pSpaceWidth;
+      } else {
+        pPosition->x += pTextSpacing->x;
+        g_HudMobys->m_Position.y += pTextSpacing->y;
+        g_HudMobys->m_Position.z = pTextSpacing->z;
+      }
+      wasCapital = isCapital;
+      if (((*pText >= 'A' && *pText <= 'Z') || (*pText >= 'a' && *pText <= 'f')) &&
+          pTextSpacing != nullptr) {
+        isCapital = 0;
+      } else {
+        isCapital = 1;
+      }
+    } else {
+      pPosition->x += pSpaceWidth * 2 / 3;
+      isCapital = 1;
+    }
+    pText++;
+  }
+  return g_HudMobys;
+}
+#endif
