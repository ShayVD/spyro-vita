 #define RT(us, pal) (g_RegionTiming ? (pal) : (us))
 #endif
 
+/* A duration the code computes, PAL's 50 Hz way (D146): from 6 up, 5/6 of
+ * it, rounded; below 6 as it is. PAL's own macro evaluates t a second time
+ * for its value, so a random duration (rand(), RandRange()) draws twice on
+ * PAL; this does the same, keeping PAL's random sequence. US, JP and PAL 60
+ * evaluate t once, as the US code does. */
+#define RT_TIME(t) (RT(0, 1) ? ((t) >= 6 ? ((t) * 5 + 3) / 6 : (t)) : (t))
+
+/* A speed the code computes, PAL's 50 Hz way (D146): 6/5 of it, rounded
+ * (a path node's speed, a random velocity, a thrown arc's). */
+#define RT_SPEED(v) (RT(0, 1) ? ((v) * 6 + 3) / 5 : (v))
+
 /* Code and data only PAL has (D134): a matching build compiles them for PAL
  * alone, so the US build's SHA-1 doesn't move; the port has them always. */
