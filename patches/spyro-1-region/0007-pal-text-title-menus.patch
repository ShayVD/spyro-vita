+            PAL_DATA(g_PalTreasureFoundX, 0x8007B984)[g_Language] + center_offset;
+        func_pal_8001BD5C(
+            PAL_DATA(g_PalTreasureFoundText, 0x80074E28)[g_Language], &vec1,
+            &vec2, 16, 11);
+      } else {
+        vec1.x =
