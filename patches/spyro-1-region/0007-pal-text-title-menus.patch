+      mobys--;
+    }
+
+    if (g_LevelTransTicks >= 64) {
+      int center_offset, displayed_counter, tally_duration, tally_countdown;
+      int scale;
+      center_offset = 40;
+      for (i = g_GemTotal; i >= 10; i = i / 10) {
+        center_offset -= 10;
