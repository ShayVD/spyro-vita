+    } else if ((g_NextLevelId < 60 && g_NextLevelId % 10 == 4) ||
+               (g_NextLevelId == 63)) {
+      sprintf(textbuffer, PAL_DATA(g_PalRescuedFormat, 0x8007BEDC),
