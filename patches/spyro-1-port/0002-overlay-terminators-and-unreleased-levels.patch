 #define NAME_OVERLAY_FUNCTION(func) CAT3(func, _, OVERLAY_NAME)
 #define NAME_OVERLAY_FUNCTION_LEVEL(func, level) CAT3(func, _LEVEL_, level)
 
+// Spyro port: an overlay's Terminator marks the end of its code and is used
+// as a data pointer (the copy buffer). Overlay code isn't loaded into RAM in
+// the port, so it's a pointer into the PS1 RAM arena (gen/ovl_table.c).
+#ifdef SPYRO_PORT
+#define OVERLAY_TERMINATOR_DECL(name) extern void *name
+void PortFatal(const char *fmt, ...);
+#else
+#define OVERLAY_TERMINATOR_DECL(name) void name(void)
+#endif
+
 extern Moby *(*g_SpawnMoby)(int pClass, Moby *pParent); // g_MobySpawn
 extern void (*g_UpdateMoby)();
 
@@ -44,7 +54,7 @@ extern int (*D_800758C4)(int pTimer, Vector3D *pPos, int pColor); // g_DrawTime
 
 
 #define o(level) \
-    void NAME_OVERLAY_FUNCTION_LEVEL(Terminator, level)(void); \
+    OVERLAY_TERMINATOR_DECL(NAME_OVERLAY_FUNCTION_LEVEL(Terminator, level)); \
     Moby *NAME_OVERLAY_FUNCTION_LEVEL(SpawnMoby, level)(int pClass, Moby *pParent); \
     void NAME_OVERLAY_FUNCTION_LEVEL(UpdateMoby, level)(void); \
     void NAME_OVERLAY_FUNCTION_LEVEL(SpawnParticle, level)(int pAmount, int pClass, void *spawnParam, int extraParam); \
