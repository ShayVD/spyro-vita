@@ -321,7 +329,19 @@
       // The top bit is unset, because it's used to indicate mesh collision
       // models So we want to take the top bit from m->m_CollisionModels[i]
       // rather than pModel
+#if SPYRO_NATIVE_MEM
+      // Spyro port (D100): the offset's top bit becomes the pointer's bit 0
+      // (psx_mem.h MEM_COLL_TAGGED), so the arena may sit below 2 GB
+      {
+        u_int off = (u_int)m->m_CollisionModels[i];
+        u_int at = (u_int)m + (off & 0x7FFFFFFF);
+        if (at & 3)
+          PortFatal("collision model %08x not word-aligned", at);
+        m->m_CollisionModels[i] = (void *)(at | off >> 31);
+      }
+#else
       PATCH_POINTER(m->m_CollisionModels[i], (u_int)m & 0x7FFFFFFF);
+#endif
     }
   }
 
@@ -357,7 +377,13 @@
