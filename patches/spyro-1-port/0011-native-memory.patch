         // define. Which would mean changing the renderer to use an offset
         // instead of a pointer.
+#if SPYRO_NATIVE_MEM
+        // Spyro port (D100): the address's low 21 bits (psx_mem.h
+        // MEM_ANIM21); with the arena not 2 MB-aligned the sum may carry
+        *p = (*p & 0xffe00000) | ((*p + (u_int)m->m_Data) & 0x1fffff);
+#else
         *p += (u_int)m->m_Data & 0x1fffff;
+#endif
         ++p;
         if ((*p & 0xffff) != 0) {
           *p += (((int)m->m_Data - (int)p + 4) >> 2) & 0xffff;
