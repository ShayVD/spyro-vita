+#if SPYRO_NATIVE_MEM
+    // Spyro port (D100): the tag is bit 0, which a model's address never
+    // has (psx_mem.h MEM_MODEL_SIMPLE), not bit 31
+    if ((u_int)pModel & 3)
+      PortFatal("SimpleModel %p not word-aligned", (void *)pModel);
