+  // timer below doesn't run (PortCdLoadPoll, src/platform/common/libcd.c,
+  // says why). Kept below the blank line so the region patches' first hunk
+  // of this file (patches/spyro-1-region/0004) keeps its context.
+  int PortCdLoadPoll(void);
+  if (PortCdLoadPoll())
+    g_CDReadTime = 0;
+#endif
+
   if (g_CDMaxReadTime == 0)
     return; // No timer set
 
