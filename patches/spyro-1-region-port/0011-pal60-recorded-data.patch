           0x262D0; // Hardcoded addresses... yippee
@@ -1603,7 +1610,7 @@ int func_800334D4(void) {
       g_Spu.m_VolumeOverride.right = 0x3FFF;
       PlaySound(0, nullptr, 16, (u_char *)&g_DragonCutscene.m_SoundVoice);
     } else {
-      g_CutsceneLayout->m_CurrentTick = RT(1168, 972);
+      g_CutsceneLayout->m_CurrentTick = RV(1168, 972, 1168); // the flyby's (D150)
     }
 
     g_TitlescreenState.m_SubState = RV(1, 2, 1);
