   duration = g_CutsceneLayout->m_Duration;
-  currentTick += g_DeltaTime;
+  currentTick += PortCutsceneTicks(g_DeltaTime); // PAL 60: PAL's 50 Hz vblanks (D150)
   duration <<= 1;
   g_CutsceneLayout->m_CurrentTick = currentTick;
 
@@ -1588,7 +1595,7 @@ int func_800334D4(void) {
 
