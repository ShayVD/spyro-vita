+// PAL's recorded cutscenes are sampled for its 25 Hz ticks, so they count
+// its 50 Hz vblanks: at US timing (PAL 60, D150) d of ours are d * 5 / 6 of
+// them, the remainder carried; otherwise d (src/game/region_game.c). The
+// port's only: PAL 60 isn't a PS1 mode, and the matching builds don't apply
+// this patch.
+int PortCutsceneTicks(int d);
+
 /// @brief Gamestate 14 - Cutscene update
 void GamestateCutsceneUpdate(void) {
 #if REGION_HAS_US
@@ -1417,7 +1424,7 @@ void GamestateCutsceneUpdate(void) {
