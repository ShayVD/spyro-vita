# A game's settings for vita-port-kit's hw_run.sh / hw_check.sh / hw_ftp.py / hw_mock.py, kept in the game repo
# (tools/vita/hw.game) and named by HW_GAME (the game's wrappers set it). Sourced by bash; hw_ftp.py and
# hw_mock.py read its plain KEY=VALUE lines, so keep those simple (no expansions).
HW_TITLE_ID=GAME00001
HW_NAME="My Game Vita"
HW_DATA=ux0:data/mygame
HW_LOG=mygame.log
# the line in HW_LOG the app writes when config.txt's frames= is reached (an extended regex)
HW_STOP_RE='frames=[0-9]+ reached'
# optional: a line meaning the app hung and stops itself for a crash dump
HW_HANG_RE=
# the VPK, relative to the game repo's root (VPK= overrides)
HW_VPK=build/vita/mygame.vpk
# the default timeout (s); no FTP for HW_QUIET_S after the launch, then a look every HW_POLL_S
HW_TIMEOUT=600
HW_QUIET_S=0
HW_POLL_S=3
# where PAD=FILE goes in HW_DATA (config.txt gets pad=HW_DATA/HW_PAD_NAME)
HW_PAD_NAME=pad.txt
# what the app writes in HW_DATA, set aside for the run and put back after (config.txt, the log and the pad
# script are always included)
HW_NAMES=(save)
# fetched into OUT_DIR after the run (files or folders in HW_DATA)
HW_COLLECT=(save)
# a folder in HW_DATA the run starts empty, or from SAVE=DIR (none: leave it empty)
HW_SAVE_DIR=save
# optional: the unstripped ELF of the build HW_VPK packs (before vita-elf-create), relative to the game repo's
# root; copied next to each crash dump a run fetches (OUT_DIR/psp2core-X.elf) with its SHA-1 in hw-run.txt, so the
# dump is read against the same build. With VPK= pointing at another build, give that build's ELF as HW_ELF= too.
# The environment's HW_ELF wins over this line.
HW_ELF=
# 1: fetch the Vita's eboot.bin before the run (OUT_DIR/eboot-before.bin) and put it back when the run ends,
# however it ends, with a read-back (only eboot.bin: a run that installed the whole app leaves its sce_sys/).
# Default 0: a batch of runs leaves its build installed; end the batch with hw_run.sh --put-eboot instead.
# The environment's HW_KEEP_APP wins over this line.
HW_KEEP_APP=0

# Optional hooks (bash functions):
#   hw_config_base OWNER_CFG  print the run's first config.txt lines (OWNER_CFG: a copy of the owner's
#                             config.txt, or empty when there is none). Default: the owner's lines but pad=.
#                             spyro-vita's keeps only the owner's disc= line, then adds realtime=0 (unless
#                             REALTIME=1), keep_awake=1 and the settings its host comparisons use (unless
#                             DEVICE_DEFAULTS=1): a game's own knobs for scripted runs belong here.
#   hw_after_setup BACKUP_DIR after the owner's files are set aside and the run's are up (BACKUP_DIR holds a
#                             copy of the owner's config.txt and small save files)
#   hw_after_collect OUT_DIR  after the run's files are fetched
#   hw_check_game             extra hw_check.sh lines: call ok / no / note with what this game needs on the Vita
