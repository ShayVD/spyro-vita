#!/usr/bin/env bash
# Run a command inside the spyro-host container (tools/docker/host.Dockerfile)
# with the repo mounted at /work and the same relative working directory.
# disc/ may be a symlink to the main checkout's disc/, so that is mounted too.
#   tools/tc cmake --build build/linux32
# TC_PORT=N also publishes container port N on the Mac's 127.0.0.1:N
# (for spyro --serve N, decisions D22).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
rel=${PWD#"$root"}
[[ "$rel" == "$PWD" ]] && rel=""
mounts=(-v "$root:/work")
if [ -L "$root/disc" ]; then
  mounts+=(-v "$(cd "$root/disc" && pwd -P):/work/disc:ro")
fi
if [ -n "${TC_PORT:-}" ]; then
  mounts+=(-p "127.0.0.1:$TC_PORT:$TC_PORT")
fi
tty=()
[ -t 0 ] && [ -t 1 ] && tty=(-it)
# Issue #175 (D136's late case): on colima's sshfs mount a built binary can
# lose its execute bit after cmake/link_exec.sh checked it, and then docker
# (exit 126) or qemu refuses it. So inside the container, where the stat is
# fresh, right before the command runs: every argument that is an ELF
# executable (e_type EXEC or DYN, not a .so) without an execute bit gets it
# back, with one line "restored execute bit: PATH" on stderr; with ctest, the
# same for every path in its CTestTestfile.cmake add_test lines. Then the
# command is exec'd as before (same PID, exit code and tty).
xbit='x() {
  case $1 in *.so | *.so.*) return 0 ;; esac
  [ -f "$1" ] && [ ! -x "$1" ] || return 0
  [ "$(od -An -tx1 -N4 "$1" 2>/dev/null | tr -d " \n")" = 7f454c46 ] || return 0
  case $(od -An -tx1 -j16 -N2 "$1" 2>/dev/null | tr -d " \n") in 0200 | 0300) ;; *) return 0 ;; esac
  n=0
  while [ ! -x "$1" ] && [ $n -lt 5 ]; do n=$((n + 1)); chmod +x "$1" 2>/dev/null || sleep 1; done
  if [ -x "$1" ]; then echo "restored execute bit: $1" >&2; else echo "could not restore execute bit: $1" >&2; fi
}
for a; do x "$a"; done
if [ "$1" = ctest ]; then
  d=.; p=; for a; do [ "$p" = --test-dir ] && d=$a; p=$a; done
  for a in $(find "$d" -name CTestTestfile.cmake -exec grep -h "^add_test" {} + 2>/dev/null | grep -o "\"[^\"]*\"" | tr -d "\"" | sort -u); do x "$a"; done
fi
exec "$@"'
cmd=("$@")
[ $# -gt 0 ] && cmd=(sh -c "$xbit" tc "$@")
exec "$root/tools/docker/run.sh" --rm ${tty[@]+"${tty[@]}"} --security-opt seccomp=unconfined \
  "${mounts[@]}" -w "/work$rel" spyro-host ${cmd[@]+"${cmd[@]}"}
