# spyro-vita's settings for Encore's hardware-run tools (third_party/encore/targets/vita/tools; the wrappers
# tools/vita/hw_run.sh, hw_check.sh, hw_ftp.py and hw_mock.py set HW_GAME to this file). Sourced by bash; the plain
# KEY=VALUE lines are also read by hw_ftp.py and hw_mock.py. Settings and hooks:
# third_party/encore/targets/vita/tools/hw.game.example. The runner itself is decision D77's.
HW_TITLE_ID=SPYV00001
HW_NAME="Spyro Vita"
HW_DATA=ux0:data/spyro
HW_LOG=spyro.log
HW_STOP_RE='reached, exiting'
HW_HANG_RE='hang: stopping the app for a crash dump'
HW_VPK=build/vita/spyro-vita.vpk
HW_TIMEOUT=120
HW_QUIET_S=0
HW_POLL_S=3
HW_PAD_NAME=pad.txt
# what the app writes in ux0:data/spyro (src/platform/vita), set aside for the run (config.txt, spyro.log and
# pad.txt always are)
HW_NAMES=(save shots audio.wav hold.req hold.ack)
HW_COLLECT=(shots audio.wav save)
HW_SAVE_DIR=save

# The run's first config.txt lines: the owner's disc= kept; virtual vblanks unless REALTIME=1; as vita3k_run.sh,
# the host's picture and camera so runs compare with it, unless DEVICE_DEFAULTS=1 (later lines win;
# config_version=6: main.c); no standby, dimming or screen off while it runs (vblank.c). The host's picture
# includes the PS1's wobble (wobble=1, #177: the device's default is off); a run's persp=1 subpixel=1 after it
# still turns the fix on, as before. The options menu writes config_version=7 since D260; this 6 (and a run
# file's own 5 after it) stays, and a run's draw_distance=200 is still a developer's 200, not an older menu's
# MAX: these base lines never write res, analog or cam_speed, three of the nine rows every menu has written
# since D48, and a run file's lines include keys no menu row has (frames=, shot_every=, ...) (read_config,
# D260).
hw_config_base() {
  [ -n "$1" ] && grep -E '^disc=' "$1" || true
  [ "${REALTIME:-0}" = 1 ] || echo "realtime=0"
  # the run's lines are its own: a developer's tex_filter= or dynres= (D153), persp= or subpixel= (#177),
  # even after a run file's own config_version=5
  echo "config_version=6"
  [ "${DEVICE_DEFAULTS:-0}" = 1 ] ||
    printf 'widescreen=0\ninterp=0\nfree_camera=0\ncam_invert_x=0\ncam_invert_y=0\nwobble=1\n'
  echo "keep_awake=1"
}

# Encore's v3k_run.sh (the autopilot's Vita3K routes): virtual vblanks unless REALTIME=1, and the PS1's
# wobble (wobble=1) unless DEVICE_DEFAULTS=1, so the routes keep the pictures they had before #177 made the fix
# the default; a route's persp=1 subpixel=1 still turns it on. Nothing else: the routes' other settings are the
# device's, as before.
v3k_config_base() {
  [ "${REALTIME:-0}" = 1 ] || echo "realtime=0"
  [ "${DEVICE_DEFAULTS:-0}" = 1 ] || echo "wobble=1"
}

# the disc image's one-time check (D60) isn't done again for every run
hw_after_setup() {
  [ -f "$1/save/disc-verified.txt" ] && [ ! -f "${SAVE:-/nonexistent}/disc-verified.txt" ] &&
    v put "$1/save/disc-verified.txt" "$HW_DATA/save/disc-verified.txt"
  return 0
}

# the shots next to the log, as before (OUT_DIR/*.png)
hw_after_collect() {
  [ -d "$1/shots" ] || return 0
  find "$1/shots" -name '*.png' -exec mv {} "$1/" \;
  rm -rf "${1:?}/shots"
}

hw_check_game() {
  local d
  if d=$(v ls "$HW_DATA" 2>/dev/null); then
    if grep -q ' manifest.json$' <<< "$d"; then
      ok "disc: the extracted files ($HW_DATA/manifest.json)"
    elif grep -qiE ' [^ ]*\.(cue|bin|img)$' <<< "$d"; then
      ok "disc: an image in $HW_DATA ($(grep -iE '\.(cue|bin|img)$' <<< "$d" | sed 's/^[df] [0-9]* //' | tr '\n' ' '))"
    else
      no "disc: no manifest.json and no .cue/.bin/.img in $HW_DATA (a disc= line in config.txt may point elsewhere)"
    fi
  fi
  if v size ur0:data/libshacccg.suprx > /dev/null 2>&1 || v size ur0:data/external/libshacccg.suprx > /dev/null 2>&1; then
    ok "ur0:data/libshacccg.suprx (the GPU's shader compiler)"
  elif v size "$HW_DATA/libshacccg.suprx" > /dev/null 2>&1; then
    ok "$HW_DATA/libshacccg.suprx (the GPU's shader compiler, from the data folder: D163)"
  else
    no "no libshacccg.suprx in ur0:data or $HW_DATA: the app falls back to the slow CPU renderer"
  fi
}
