#!/usr/bin/env bash
# Run a command inside the spyro-ps4 container (tools/docker/ps4.Dockerfile,
# D180) with the repo mounted at /work and the same relative working
# directory, as tools/tc does for spyro-host.
#   tools/ps4/tc tools/ps4/spike/build.sh
set -euo pipefail
root=$(cd "$(dirname "$0")/../.." && pwd)
rel=${PWD#"$root"}
[[ "$rel" == "$PWD" ]] && rel=""
tty=()
[ -t 0 ] && [ -t 1 ] && tty=(-it)
exec docker run --rm ${tty[@]+"${tty[@]}"} --platform linux/arm64 \
  -v "$root:/work" -w "/work$rel" spyro-ps4 "$@"
